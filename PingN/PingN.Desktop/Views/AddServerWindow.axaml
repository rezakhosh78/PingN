<Window
    x:Class="PingN.Desktop.Views.AddServerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:PingN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:views="clr-namespace:PingN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuServers}"
    Width="900"
    MinWidth="400"
    Height="600"
    x:DataType="vms:AddServerViewModel"
    Design.DataContext="{x:Static dd:DesignData.AddServer}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>
        <ScrollViewer x:Name="serverEditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <Grid
                    x:Name="gridBasic"
                    Grid.Row="0"
                    ColumnDefinitions="160,*"
                    RowDefinitions="Auto,Auto,Auto,Auto">

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        x:Name="tbServerType"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        Text="{x:Static resx:ResUI.menuServers}" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Vertical">
                        <ComboBox
                            x:Name="cmbCoreType"

                            Margin="{StaticResource Margin4}"
                            ToolTip.Tip="{x:Static resx:ResUI.TbCoreType}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbRemarks}" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
<TextBox
                        x:Name="txtRemarks"



                        Margin="{StaticResource Margin4}" />
</StackPanel>

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        x:Name="tbAddress"
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAddress}" />
                    <TextBox
                        x:Name="txtAddress"
                        Grid.Row="2"
                        Grid.Column="1"

                        Margin="{StaticResource Margin4}" />

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        x:Name="tbPort"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbPort}" />
                    <TextBox
                        x:Name="txtPort"
                        Grid.Row="3"
                        Grid.Column="1"

                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Stretch" />
                </Grid>

                <Separator Grid.Row="1" Margin="{StaticResource MarginTb8}" />

                <Grid
                    x:Name="gridVMess"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId}" />
                    <TextBox
                        x:Name="txtId"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />
                    <Button
                        x:Name="btnGUID"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="{StaticResource MarginLr4}"
                        Content="{x:Static resx:ResUI.TbGUID}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbAlterId}" />
                    <TextBox
                        x:Name="txtAlterId"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSecurity}" />
                    <ComboBox
                        x:Name="cmbSecurity"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleSwitch
                        x:Name="togmuxEnabled"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridSs"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId3}" />
                    <TextBox
                        x:Name="txtId3"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSecurity3}" />
                    <ComboBox
                        x:Name="cmbSecurity3"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="300"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbUot}" />
                    <ToggleSwitch
                        x:Name="togUotEnabled3"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleSwitch
                        x:Name="togmuxEnabled3"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridSocks"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSecurity4}" />
                    <TextBox
                        x:Name="txtSecurity4"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId4}" />
                    <TextBox
                        x:Name="txtId4"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        x:Name="tbHttpHeaders"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        Text="{x:Static resx:ResUI.TbHttpOutboundHeaders}"
                        ToolTip.Tip="{x:Static resx:ResUI.TipHttpOutboundHeaders}" />
                    <views:JsonEditor
                        x:Name="txtHttpHeadersJson"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="400"
                        MinHeight="100"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        ToolTip.Tip="{x:Static resx:ResUI.TipHttpOutboundHeaders}" />
                </Grid>
                <Grid
                    x:Name="gridWarpAmnezia"
                    Grid.Row="2"
                    IsVisible="False"

                   ><StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Proxy" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbWarpAmneziaRegistrationProxy" Grid.Column="1" Width="400" HorizontalAlignment="Left" />
                    </Grid>
                    <Button x:Name="btnWarpAmneziaGenerateKey" Content="Generate WARP Key" Margin="4" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtWarpAmneziaKeyStatus" Margin="4" TextWrapping="Wrap" />
<TextBlock


                        Margin="{StaticResource Margin4}"
                        FontWeight="SemiBold"
                        Text="WARP AmneziaWG settings" />
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Private key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPrivateKey" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Address" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgAddress" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="DNS" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgDns" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="MTU" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgMtu" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jc" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJc" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jmin" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJmin" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jmax" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJmax" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="S1" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgS1" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="S2" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgS2" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H1" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH1" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H2" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH2" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H3" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH3" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H4" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH4" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgEndpoint" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Peer public key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPublicKey" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Preshared key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPresharedKey" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Allowed IPs" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgAllowedIPs" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Persistent keepalive" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPersistentKeepalive" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Listen port" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgListenPort" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Scan IP family" /><ComboBox
 Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch"                        x:Name="cmbWarpAmneziaScanFamily"


                        Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Scan type" /><ComboBox
 Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch"                        x:Name="cmbWarpAmneziaScanMode"


                        Margin="{StaticResource Margin4}" /></Grid>
<CheckBox
                        x:Name="chkWarpAmneziaAutoScan"


                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" Content="Scan endpoints automatically on connect" />
<WrapPanel


                        Margin="{StaticResource Margin4}"
                        Orientation="Horizontal">
                        <Button
                            x:Name="btnScanWarpAmneziaEndpoint"
                            Margin="{StaticResource Margin4}"
                            Content="Rescan endpoints" />
                        <Button
                            x:Name="btnApplyWarpAmneziaEndpoint"
                            Margin="{StaticResource Margin4}"
                            Content="Apply scanned endpoint"
                            IsEnabled="{Binding HasScannedWarpAmneziaEndpoint}" />
                    </WrapPanel>
<TextBlock
                        x:Name="tbWarpAmneziaScanStatus"


                        Margin="{StaticResource Margin4}"
                        TextWrapping="Wrap" />
</StackPanel></Grid>
                <Grid
                    x:Name="gridWarpMasque"
                    Grid.Row="2"
                    IsVisible="False"

                   ><StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Proxy" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbWarpMasqueRegistrationProxy" Grid.Column="1" Width="400" HorizontalAlignment="Left" />
                    </Grid>
                    <Button x:Name="btnWarpMasqueGenerateKey" Content="Generate WARP Key" Margin="4" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtWarpMasqueKeyStatus" Margin="4" TextWrapping="Wrap" />
<TextBlock Margin="{StaticResource Margin4}" FontWeight="SemiBold" Text="WARP MASQUE/H2 settings" />
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Device name" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueDeviceName" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="SNI" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueSni" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Primary endpoint" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpoint" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint port" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpointPort" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint candidates" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpointCandidates" Margin="{StaticResource Margin4}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" /></Grid>
<Grid Margin="0,2" ColumnDefinitions="160,*"><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="DNS servers" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueDns" Margin="{StaticResource Margin4}" /></Grid>
<CheckBox x:Name="chkWarpMasqueAutoScan" Margin="{StaticResource Margin4}" HorizontalAlignment="Left" Content="Scan endpoints automatically on connect" />
<CheckBox x:Name="chkWarpMasqueHttp2Enabled" Margin="{StaticResource Margin4}" HorizontalAlignment="Left" Content="Use HTTP/2" />
<WrapPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                        <Button x:Name="btnScanWarpMasqueEndpoint" Margin="{StaticResource Margin4}" Content="Rescan endpoints" />
                        <Button x:Name="btnApplyWarpMasqueEndpoint" Margin="{StaticResource Margin4}" Content="Apply scanned endpoint" IsEnabled="{Binding HasScannedWarpMasqueEndpoint}" />
                    </WrapPanel>
<TextBlock x:Name="tbWarpMasqueScanStatus" Margin="{StaticResource Margin4}" TextWrapping="Wrap" />
</StackPanel></Grid>
                <Grid
                    x:Name="gridVLESS"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId5}" />
                    <TextBox
                        x:Name="txtId5"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />
                    <Button
                        x:Name="btnGUID5"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="{StaticResource MarginLr4}"
                        Content="{x:Static resx:ResUI.TbGUID}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbFlow5}" />
                    <ComboBox
                        x:Name="cmbFlow5"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSecurity5}" />
                    <TextBox
                        x:Name="txtSecurity5"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleSwitch
                        x:Name="togmuxEnabled5"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridTrojan"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId3}" />
                    <TextBox
                        x:Name="txtId6"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbFlow5}" />
                    <ComboBox
                        x:Name="cmbFlow6"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleSwitch
                        x:Name="togmuxEnabled6"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridHysteria2"
                    Grid.Row="2"
                    ColumnDefinitions="300,Auto,Auto"
                    IsVisible="False"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Text="{x:Static resx:ResUI.TbId3}" />
                    <TextBox
                        x:Name="txtId7"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="{StaticResource MarginLr4}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Classes="IconButton">
                        <Button.Content>
                            <PathIcon Data="{StaticResource SemiIconMore}">
                                <PathIcon.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </PathIcon.RenderTransform>
                            </PathIcon>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel>
                                    <TextBlock
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbPath7}" />
                                    <TextBox
                                        x:Name="txtPath7"
                                        Width="400"
                                        Margin="{StaticResource Margin4}" />
                                    <TextBlock
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Text="{x:Static resx:ResUI.TbGeckoPacketSize}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txtMinGeckoPacketSize"
                                            Width="90"
                                            Margin="{StaticResource Margin4}"
                                            PlaceholderText="Min" />
                                        <TextBox
