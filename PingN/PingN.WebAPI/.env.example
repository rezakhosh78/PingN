# PingN.WebAPI environment example
#
# Copy this file to .env before starting:
#
#   cp .env.example .env
#   ./PingN.WebAPI
#
# Native local installs may leave PingN_WEB_API_KEY empty ONLY with loopback
# listeners (127.0.0.1, localhost, [::1]) and complete setup in a local browser.
# LAN/NAS/headless/systemd/container deployments must preconfigure a non-empty Key.
# Any non-loopback listener requires this environment Key, even after local setup.

PingN_WEB_API_KEY=

# Optional exact browser/client origins. Empty/unset denies cross-origin API access.
# Origin = scheme + host + port, never a path, query, fragment or wildcard.
# PingN_WEB_ALLOWED_ORIGINS=https://client.example.com,http://localhost:5173

# Web management interface. The default listens only on loopback.
# Set PingN_WEB_API_KEY before changing this to http://0.0.0.0:5080 for LAN access.
ASPNETCORE_URLS=http://127.0.0.1:5080

# Start the selected Core automatically after authentication setup.
PingN_WEB_AUTOSTART=true

# Optional proxy listener port.
# PingN_WEB_PROXY_PORT=10808

# Allow proxy clients outside localhost.
# PingN_WEB_PROXY_LISTEN_ALL=false

# Optional writable data directory.
# PingN_DATA_HOME=/path/to/PingN-data
