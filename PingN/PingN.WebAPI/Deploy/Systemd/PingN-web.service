[Unit]
Description=PingN Web API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=PingN
Group=PingN
WorkingDirectory=/opt/PingN-web
ExecStart=/opt/PingN-web/PingN.WebAPI --foreground
EnvironmentFile=/etc/PingN-web.env
Environment=ASPNETCORE_URLS=http://0.0.0.0:5080
Environment=PingN_WEB_AUTOSTART=true
Environment=PingN_DATA_HOME=/var/lib/PingN-web
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/PingN-web/.net-bundle
StateDirectory=PingN-web
StateDirectoryMode=0750
UMask=0077
Restart=always
RestartSec=3
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/PingN-web

[Install]
WantedBy=multi-user.target
