<base:WindowBase
    x:Class="PingN.Views.AddServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:PingN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuServers}"
    Width="900"
    MinWidth="400"
    Height="700"
    x:TypeArguments="vms:AddServerViewModel"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>
        <ScrollViewer x:Name="serverEditorScroll"
            materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="gridBasic" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource ModuleTitle}"
                        Text="{x:Static resx:ResUI.menuServers}" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Vertical">
                        <ComboBox
                            x:Name="cmbCoreType"
                           
                            Margin="{StaticResource Margin4}"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TbCoreType}"
                            Style="{StaticResource DefComboBox}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbRemarks}" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
<TextBox
                        x:Name="txtRemarks"
                        
                        
                       
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />
</StackPanel>

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        x:Name="tbAddress"
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbAddress}" />
                    <TextBox
                        x:Name="txtAddress"
                        Grid.Row="2"
                        Grid.Column="1"
                       
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />

                    <TextBlock HorizontalAlignment="Right" TextWrapping="Wrap"
                        x:Name="tbPort"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbPort}" />
                    <TextBox
                        x:Name="txtPort"
                        Grid.Row="3"
                        Grid.Column="1"
                       
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource DefTextBox}" />
                </Grid>

                <Separator
                    x:Name="sepaCommon"
                    Grid.Row="1"
                    Margin="0,2"
                    Style="{DynamicResource MaterialDesignSeparator}" />

                <Grid
                    x:Name="gridVMess"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbId}" />
                    <TextBox
                        x:Name="txtId"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />
                    <Button
                        x:Name="btnGUID"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="{StaticResource MarginLeftRight4}"
                        Content="{x:Static resx:ResUI.TbGUID}"
                        Style="{StaticResource DefButton}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbAlterId}" />
                    <TextBox
                        x:Name="txtAlterId"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource DefTextBox}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbSecurity}" />
                    <ComboBox
                        x:Name="cmbSecurity"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="200"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefComboBox}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleButton
                        x:Name="togmuxEnabled"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridSs"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbId3}" />
                    <TextBox
                        x:Name="txtId3"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbSecurity3}" />
                    <ComboBox
                        x:Name="cmbSecurity3"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="300"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefComboBox}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbUot}" />
                    <ToggleButton
                        x:Name="togUotEnabled3"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbSettingsMuxEnabled}" />
                    <ToggleButton
                        x:Name="togmuxEnabled3"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="{StaticResource Margin4}"
                        HorizontalAlignment="Left" />
                </Grid>
                <Grid
                    x:Name="gridSocks"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbSecurity4}" />
                    <TextBox
                        x:Name="txtSecurity4"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Center"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbId4}" />
                    <TextBox
                        x:Name="txtId4"
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        Style="{StaticResource DefTextBox}" />

                    <TextBlock
                        x:Name="tbHttpHeaders"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="{StaticResource Margin4}"
                        VerticalAlignment="Top"
                        Style="{StaticResource ToolbarTextBlock}"
                        Text="{x:Static resx:ResUI.TbHttpOutboundHeaders}"
                        Visibility="Collapsed" />
                    <TextBox
                        x:Name="txtHttpHeadersJson"
                        Grid.Row="3"
                        Grid.Column="1"
                        Width="400"
                        Margin="{StaticResource Margin4}"
                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.TipHttpOutboundHeaders}"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        MaxLines="8"
                        MinLines="4"
                        Style="{StaticResource MyOutlinedTextBox}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed" />
                </Grid>
                <Grid
                    x:Name="gridWarpAmnezia"
                    Grid.Row="2"
                    Visibility="Collapsed"><StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Proxy" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbWarpAmneziaRegistrationProxy" Grid.Column="1" Width="400" HorizontalAlignment="Left" />
                    </Grid>
                    <Button x:Name="btnWarpAmneziaGenerateKey" Content="Generate WARP Key" Margin="4" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtWarpAmneziaKeyStatus" Margin="4" TextWrapping="Wrap" />
<TextBlock Margin="{StaticResource Margin4}" Style="{StaticResource ModuleTitle}" Text="WARP AmneziaWG settings" />
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Private key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPrivateKey" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Public key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPublicKey" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Address" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgAddress" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="DNS" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgDns" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="MTU" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgMtu" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jc" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJc" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jmin" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJmin" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Jmax" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgJmax" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="S1" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgS1" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="S2" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgS2" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H1" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH1" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H2" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH2" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H3" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH3" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="H4" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgH4" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Preshared key" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPresharedKey" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Allowed IPs" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgAllowedIPs" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgEndpoint" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Persistent keepalive" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgPersistentKeepalive" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Listen port" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpAwgListenPort" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Scan IP family" /><ComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="cmbWarpAmneziaScanFamily" Margin="{StaticResource Margin4}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Scan type" /><ComboBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="cmbWarpAmneziaScanMode" Margin="{StaticResource Margin4}" /></Grid>
<WrapPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                        <Button x:Name="btnScanWarpAmneziaEndpoint" Margin="{StaticResource Margin4}" Content="Rescan endpoints" Style="{StaticResource DefButton}" />
                        <Button x:Name="btnApplyWarpAmneziaEndpoint" Margin="{StaticResource Margin4}" Content="Apply scanned endpoint" Style="{StaticResource DefButton}" />
                    </WrapPanel>
<TextBlock x:Name="tbWarpAmneziaScanStatus" Margin="{StaticResource Margin4}" TextWrapping="Wrap" />
</StackPanel></Grid>
                <Grid
                    x:Name="gridWarpMasque"
                    Grid.Row="2"
                    Visibility="Collapsed"><StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Proxy" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbWarpMasqueRegistrationProxy" Grid.Column="1" Width="400" HorizontalAlignment="Left" />
                    </Grid>
                    <Button x:Name="btnWarpMasqueGenerateKey" Content="Generate WARP Key" Margin="4" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtWarpMasqueKeyStatus" Margin="4" TextWrapping="Wrap" />
<TextBlock Margin="{StaticResource Margin4}" Style="{StaticResource ModuleTitle}" Text="WARP MASQUE/H2 settings" />
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Device name" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueDeviceName" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="SNI" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueSni" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Primary endpoint" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpoint" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint port" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpointPort" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="Endpoint candidates" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueEndpointCandidates" Margin="{StaticResource Margin4}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Style="{StaticResource MyOutlinedTextBox}" /></Grid>
<Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="DNS servers" /><TextBox Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" x:Name="txtWarpMasqueDns" Margin="{StaticResource Margin4}" Style="{StaticResource DefTextBox}" /></Grid>
<CheckBox x:Name="chkWarpMasqueAutoScan" Margin="{StaticResource Margin4}" HorizontalAlignment="Left" Content="Scan endpoints automatically on connect" />
<CheckBox x:Name="chkWarpMasqueHttp2Enabled" Margin="{StaticResource Margin4}" HorizontalAlignment="Left" Content="Use HTTP/2" />
<WrapPanel Margin="{StaticResource Margin4}" Orientation="Horizontal">
                        <Button x:Name="btnScanWarpMasqueEndpoint" Margin="{StaticResource Margin4}" Content="Rescan endpoints" Style="{StaticResource DefButton}" />
                        <Button x:Name="btnApplyWarpMasqueEndpoint" Margin="{StaticResource Margin4}" Content="Apply scanned endpoint" Style="{StaticResource DefButton}" />
                    </WrapPanel>
<TextBlock x:Name="tbWarpMasqueScanStatus" Margin="{StaticResource Margin4}" TextWrapping="Wrap" />
</StackPanel></Grid>
                <Grid
                    x:Name="gridVLESS"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
